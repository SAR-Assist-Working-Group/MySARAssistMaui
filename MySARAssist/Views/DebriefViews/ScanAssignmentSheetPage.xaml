<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="MySARAssist.Views.DebriefViews.ScanAssignmentSheetPage"
             Title="Scan Assignment QR">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <zxing:CameraBarcodeReaderView
            Grid.Row="0"
            x:Name="BarcodeReader"
            BarcodesDetected="BarcodeReader_BarcodesDetected"
            IsDetecting="True" />

        <VerticalStackLayout Grid.Row="1" Padding="20" BackgroundColor="{AppThemeBinding Light={StaticResource OffWhite}, Dark={StaticResource OffBlack}}">
            <Label 
                Text="Point camera at the QR code on the printed assignment sheet (ICS 204)."
                HorizontalTextAlignment="Center"
                FontSize="15"
                TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}" />
            
            <Button 
                Text="Cancel / Enter Manually" 
                Style="{StaticResource BackButton}"
                Clicked="CancelButton_Clicked" 
                Margin="0,15,0,0" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>


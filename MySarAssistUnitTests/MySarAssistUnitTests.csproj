  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MySarAssistModels\MySarAssistModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
